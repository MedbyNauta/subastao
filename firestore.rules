rules_version = '2';
// Online multiplayer rules for Subastao/Pocha.
// - Room docs: only members can read once a game is playing. Lobby rooms can
//   be fetched by code so a guest can join; collection queries are denied
//   (no enumerating every room). A separate `lobbies` index is what the
//   "open rooms" UI lists — it holds only non-secret lobby metadata.
// - Room updates: host can publish game state; lobby joiners may only add
//   themselves to players/memberUids (or refresh their own player row).
// - Hands live in rooms/{id}/hands/{authUid} — readable only by that uid,
//   writable only by the host. Shared stateJson must not include private hands.
// - Actions: members create their own; only the host deletes after applying.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function roomDoc() {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }
    function isHostOf(data) {
      return signedIn() && data.hostUid == request.auth.uid;
    }
    function isMemberOf(data) {
      return signedIn() && request.auth.uid in data.memberUids;
    }
    function onlyKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // Guest joining a lobby for the first time: exactly one new member uid,
    // and it must be the caller. Host/game fields stay unchanged.
    function isLobbyJoin() {
      return resource.data.status == 'lobby'
        && request.resource.data.status == 'lobby'
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.gameType == resource.data.gameType
        && !(request.auth.uid in resource.data.memberUids)
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && onlyKeys(['players', 'memberUids']);
    }
    // Same tab reconnecting: already a member, may refresh players rows only.
    function isLobbyReconnect() {
      return resource.data.status == 'lobby'
        && request.resource.data.status == 'lobby'
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.memberUids == resource.data.memberUids
        && request.auth.uid in resource.data.memberUids
        && onlyKeys(['players']);
    }

    match /lobbies/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'gameType', 'hostUid', 'hostName', 'playerCount', 'maxSeats', 'createdAt'
        ]);
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.keys().hasOnly([
          'gameType', 'hostUid', 'hostName', 'playerCount', 'maxSeats', 'createdAt'
        ]);
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow get: if signedIn() && (
        isMemberOf(resource.data) || resource.data.status == 'lobby'
      );
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.status == 'lobby'
        && request.resource.data.keys().hasAll([
          'gameType', 'hostUid', 'status', 'players', 'memberUids'
        ]);

      allow update: if signedIn() && (
        (isHostOf(resource.data)
          && request.resource.data.hostUid == resource.data.hostUid
          && request.auth.uid in request.resource.data.memberUids)
        || isLobbyJoin()
        || isLobbyReconnect()
      );
      allow delete: if false;

      match /actions/{actionId} {
        allow read: if isMemberOf(roomDoc());
        allow create: if isMemberOf(roomDoc())
          && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isHostOf(roomDoc());
      }

      match /hands/{playerUid} {
        allow read: if signedIn()
          && request.auth.uid == playerUid
          && isMemberOf(roomDoc());
        allow create, update: if isHostOf(roomDoc())
          && request.resource.data.keys().hasOnly(['cardsJson', 'seat', 'updatedAt']);
        allow delete: if isHostOf(roomDoc());
      }
    }
  }
}
